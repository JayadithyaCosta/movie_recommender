# --- Database ---
DATABASE_URL="postgresql://user:pass@localhost:5432/movierecs"

# --- LLM (all calls routed through src/lib/llm) ---
# Gemini is the default: it is the only one of the three with a free API tier.
# Free-tier prompts may be used by Google to improve their products — fine here
# (wizard paths carry no PII), reconsider before going public.
LLM_PROVIDER="gemini"               # "gemini" | "anthropic" | "openai"
LLM_MODEL="gemini-3.6-flash"        # free stable Flash models: gemini-3.6-flash,
                                    # gemini-3.5-flash, gemini-3.5-flash-lite,
                                    # gemini-2.5-flash, gemini-2.5-flash-lite
GEMINI_API_KEY=""                   # aistudio.google.com/apikey — no card required
ANTHROPIC_API_KEY=""                # paid only, no free tier
OPENAI_API_KEY=""                   # paid only, no free tier

# --- TMDB (v4 read access token, Bearer auth) ---
TMDB_READ_TOKEN=""

# --- Auth.js v5 ---
AUTH_SECRET=""                      # `openssl rand -base64 32`
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_RESEND_KEY=""                  # magic-link email provider

# --- Optional ---
REDIS_URL=""                        # only if moving pathHash cache off Postgres
RATE_LIMIT_DISABLED="false"         # "true" locally to skip rate limiting
